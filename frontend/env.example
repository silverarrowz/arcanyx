# Copy to frontend/.env (never commit .env)
# Restart Expo after changing.

# Backend base URL, no trailing slash.
# Phone: use the public HTTPS domain, not 127.0.0.1 and not :8000.
# iOS sign-in sheet drops a custom port and hangs on plain HTTP.
# Examples:
#   EXPO_PUBLIC_API_BASE_URL=https://arcanyx.ru
#   EXPO_PUBLIC_API_BASE_URL=http://192.168.0.101:8000   # local Docker, tarot chat only
# Meditation audio is served from the same API: /media/meditations/<file>.mp3
EXPO_PUBLIC_API_BASE_URL=http://127.0.0.1:8000

# Google login is configured on the backend (GOOGLE_CLIENT_ID / SECRET).
# This app only needs the API URL above.
