# Copy this file to backend/.env and fill in real values.
# Do not commit backend/.env.

MISTRAL_API_KEY=

# Dream Interpreter agent (JSON schema, one-shot). Do not reuse for tarot chat.
MISTRAL_AGENT_ID=

# Tarot Interpreter agent (plain text, Conversations API). Create a second agent
# in Mistral Studio → Agents. Response format must be Text, not JSON-Schema.
# Paste-ready instructions: backend/data/tarot_agent_instructions.txt
MISTRAL_TAROT_AGENT_ID=

DEBUG_AI_ERRORS=false

# fal.ai image generation (dream illustrations).
# Dashboard → Keys: https://fal.ai/dashboard/keys
# Key format is usually key_id:key_secret (one string).
FAL_KEY=
FAL_IMAGE_MODEL=fal-ai/flux/schnell

# MongoDB Atlas (preferred) or local Docker.
# Atlas: mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/mystix?retryWrites=true&w=majority
# Local Docker: docker compose --profile local-db up -d mongo
#               MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB=mystix

# Long random string for session tokens. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=

# Public URL of this API, no trailing slash. Used as the Google OAuth callback host.
# Local Docker (Mac browser only): http://127.0.0.1:8000
# Phone + Google login:            https://arcanyx.ru
PUBLIC_API_URL=https://arcanyx.ru

# Meditation media (Timeweb S3). Catalog: backend/data/meditations.json
# Files currently sit in the bucket root:
#   https://s3.twcstorage.ru/<bucket>/<file>.mp3
# Leave prefixes empty. If you later move files into a folder, set the prefix.
S3_PUBLIC_BASE_URL=https://s3.twcstorage.ru/f37d10a9-8395-43a1-8ef6-7041b336e49b
S3_MEDITATIONS_PREFIX=
S3_COVERS_PREFIX=

# Admin panel and write access to Timeweb S3.
ADMIN_EMAILS=fckgmia@gmail.com
S3_ENDPOINT_URL=https://s3.twcstorage.ru
S3_BUCKET=f37d10a9-8395-43a1-8ef6-7041b336e49b
S3_REGION=ru-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
ADMIN_AUDIO_MAX_MB=120
ADMIN_COVER_MAX_MB=12

# Google Cloud Console → APIs & Services → Credentials → OAuth 2.0 Client ID
# Type: Web application
# Authorized redirect URIs (must match PUBLIC_API_URL exactly):
#   https://arcanyx.ru/api/auth/google/callback
#   http://127.0.0.1:8000/api/auth/google/callback
#   http://localhost:8000/api/auth/google/callback
# OAuth consent screen: External, add yourself as a test user while the app is in Testing.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional extra Google clients if you later add native iOS/Android login.
# GOOGLE_IOS_CLIENT_ID=
# GOOGLE_ANDROID_CLIENT_ID=

# Resend (password reset emails). Do not commit the real key.
# After buying a domain, add it in Resend → Domains and paste their DNS
# records in Timeweb. Then send from that domain, e.g.:
#   MAIL_FROM=Arcanyx <noreply@mail.arcanyx.ru>
RESEND_API_KEY=
MAIL_FROM=Arcanyx <noreply@mail.arcanyx.ru>
# Support notifications go here. Falls back to the first ADMIN_EMAILS address.
SUPPORT_EMAIL=

# Optional extra frontend origins for the OAuth return, comma-separated.
# Localhost is already allowed. Add production web origin when you have one.
# AUTH_REDIRECT_ALLOWLIST=https://mystix.your-domain.ru
# AUTH_ALLOW_LOCALHOST=true
